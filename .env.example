# Base de datos (SQLite por defecto, archivo local)
DATABASE_URL="file:./dev.db"

# Secreto para firmar los tokens de sesión (JWT). Cambiar en producción.
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# --- Mercado Pago ---
# Deja MP_MOCK=true para usar el modo simulado (sin cobros reales).
# Para cobros reales: pon MP_MOCK=false y agrega tu Access Token de producción.
MP_MOCK="true"
MP_ACCESS_TOKEN=""
# URL pública del sitio (para webhooks y redirecciones de pago).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
