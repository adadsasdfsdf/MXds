# --- Base de datos (PostgreSQL) ---
# En local puedes usar un Postgres gratuito de Neon (https://neon.tech)
# o Supabase. Pega aquí la cadena de conexión.
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"
# DIRECT_URL se usa para migraciones (algunos proveedores lo requieren).
# Si no tienes una URL directa, pon el mismo valor que DATABASE_URL.
DIRECT_URL="postgresql://usuario:password@host/db?sslmode=require"

# Secreto para firmar los tokens de sesión (JWT). Cambiar en producción.
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Token para el endpoint /api/seed (sembrar datos una vez tras desplegar).
SEED_TOKEN="pon-un-token-secreto-aqui"

# --- Mercado Pago ---
# Deja MP_MOCK=true para usar el modo simulado (sin cobros reales).
MP_MOCK="true"
MP_ACCESS_TOKEN=""
# URL pública del sitio (para webhooks y redirecciones de pago).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
